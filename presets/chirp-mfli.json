{
  "format": "halbach-hall-preset",
  "version": 1,
  "name": "CHIRP · Zurich Instruments MFLI (AC source + lock-in)",
  "method": {
    "kind": "chirp",
    "tc_ms": 100,
    "lock_timeout_s": 30,
    "carrier_hz": 700,
    "levels_mA": [0.5, 1, 2],
    "rot_hz": 0.2,
    "cycles": 4,
    "mask_s": 3,
    "direction": "both"
  },
  "hardware": {
    "backend": "real",
    "temperature": "off",
    "magnet": {
      "rotator": "OWISPS10",
      "rotator_addr": "COM3",
      "baud": 9600,
      "counts_per_turn": 4000,
      "velocity_scale": 1,
      "encoder": "",
      "angle_offset_deg": 0,
      "dir_sign": 1
    },
    "source": {
      "model": "MFLI",
      "address": "127.0.0.1:8004/dev1234",
      "compliance_V": 10,
      "max_mA": 10
    },
    "measure": {
      "lockin1": "MFLI",
      "lockin1_addr": "127.0.0.1:8004/dev1234"
    }
  }
}
